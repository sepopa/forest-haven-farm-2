# Copy this file to .env and adjust as needed.

# SQLite by default — swap for a Postgres/MySQL URL later without changing app code.
DATABASE_URL=sqlite:///./forest_haven.db

# Comma-separated list of origins allowed to call this API (your React dev server / deployed site).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs admin login sessions (JWT). Set this to a long random string in any
# real deployment — anyone with this secret can mint themselves an admin
# session.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Where uploaded admin photos/videos are saved on disk. Only used as a
# fallback when Cloudinary (below) isn't configured.
UPLOAD_DIR=./uploads

# Free Cloudinary account (cloudinary.com, no credit card needed) for storing
# admin-uploaded photos/videos. Leave all three blank to fall back to saving
# on local disk instead (fine for local dev, but files won't survive a
# restart on hosts with an ephemeral filesystem, like Render's free tier).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL of the deployed frontend — used to build links inside emails
# (e.g. the password-reset link). Not the API's own URL.
FRONTEND_URL=http://localhost:5173

# Outbound email (order notifications, order confirmations, password reset).
#
# PRODUCTION (e.g. Render free tier, which BLOCKS SMTP ports 25/465/587):
# send over HTTPS with a free Brevo account (brevo.com, no credit card).
#   BREVO_API_KEY = an API key from Brevo (SMTP & API -> API Keys)
#   FROM_EMAIL    = a sender address you verified in Brevo (Senders & IP)
# Leave SMTP_* blank when using Brevo.
BREVO_API_KEY=
FROM_NAME=Forest Haven Farm

# LOCAL DEV alternative: any SMTP relay (Gmail/Yahoo app password, etc.).
# Ignored when BREVO_API_KEY is set. If neither Brevo nor SMTP is configured,
# emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@foresthavenfarm.example

# Every submitted order is emailed here in bill format. (The admin panel's
# Parameters -> "Order notification email" takes priority over this value.)
ORDER_NOTIFY_EMAIL=epforest@yahoo.com
