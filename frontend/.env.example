# Copy this file to .env and fill in your InsForge project's values
# (dashboard → Install → API Keys, or `npx @insforge/cli secrets get ANON_KEY`).
# Both are safe to ship to the browser — every table is protected by
# row-level security (see /migrations).
VITE_INSFORGE_BASE_URL=https://your-app-key.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key
